generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  aiConfig  Json     @default("{}") @map("ai_config")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users         User[]
  waCredentials WaCredential[]
  leads         Lead[]
  conversations Conversation[]
  messages      Message[]
  broadcasts    Broadcast[]
  broadcastLogs BroadcastLog[]
  sessions      Session[]

  @@map("businesses")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        String    @default("ADMIN") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()
  inviteToken String?   @map("invite_token") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations  Conversation[]  @relation("HumanTakeover")
  broadcasts     Broadcast[]
  sessions       Session[]
  messages       Message[]       @relation("HumanMessage")

  @@index([businessId])
  @@index([email])
  @@map("users")
}

model WaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  waNumber        String    @map("wa_number") @db.VarChar(15)
  waId            String?   @map("wa_id") @db.VarChar(100)
  sessionData     Json?     @map("session_data")
  status          String    @default("DISCONNECTED") @db.VarChar(20)
  qrCode          String?   @map("qr_code")
  qrExpiresAt     DateTime? @map("qr_expires_at") @db.Timestamptz()
  lastConnectedAt DateTime? @map("last_connected_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, waNumber])
  @@index([businessId])
  @@map("wa_credentials")
}

model Lead {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  name           String?   @db.VarChar(200)
  waNumber       String    @map("wa_number") @db.VarChar(15)
  waId           String?   @map("wa_id") @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url")
  segment        String?   @db.VarChar(50)
  labels         String[]  @default([])
  score          Int       @default(0)
  status         String    @default("ACTIVE") @db.VarChar(20)
  intent         String?   @db.VarChar(50)
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz()
  dailyAiCount   Int       @default(0) @map("daily_ai_count")
  totalMessages  Int       @default(0) @map("total_messages")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  broadcastLogs BroadcastLog[]

  @@unique([businessId, waNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, segment])
  @@index([businessId, lastMessageAt])
  @@map("leads")
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  leadId     String    @map("lead_id") @db.Uuid
  status     String    @default("AI") @db.VarChar(10)
  humanId    String?   @map("human_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt    DateTime? @map("ended_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  human    User?     @relation("HumanTakeover", fields: [humanId], references: [id])
  messages Message[]

  @@index([businessId])
  @@index([businessId, leadId])
  @@index([businessId, status])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  message        String
  messageType    String   @default("text") @map("message_type") @db.VarChar(20)
  mediaUrl       String?  @map("media_url")
  fromRole       String   @map("from_role") @db.VarChar(10)
  humanId        String?  @map("human_id") @db.Uuid
  aiModel        String?  @map("ai_model") @db.VarChar(50)
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  human        User?        @relation("HumanMessage", fields: [humanId], references: [id])

  @@index([businessId])
  @@index([businessId, conversationId, createdAt(sort: Desc)])
  @@index([businessId, createdAt])
  @@map("messages")
}

model Broadcast {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  title         String   @db.VarChar(200)
  message       String
  templateVars  String[] @default([]) @map("template_vars")
  filter        Json?
  scheduleType  String   @default("once") @map("schedule_type") @db.VarChar(20)
  scheduleAt    DateTime @map("schedule_at") @db.Timestamptz()
  status        String   @default("PENDING") @db.VarChar(20)
  totalTarget   Int      @default(0) @map("total_target")
  totalSent     Int      @default(0) @map("total_sent")
  totalDelivered Int     @default(0) @map("total_delivered")
  totalRead     Int      @default(0) @map("total_read")
  totalFailed   Int      @default(0) @map("total_failed")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator       User           @relation(fields: [createdBy], references: [id])
  broadcastLogs BroadcastLog[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, scheduleAt])
  @@map("broadcasts")
}

model BroadcastLog {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  broadcastId   String    @map("broadcast_id") @db.Uuid
  leadId        String    @map("lead_id") @db.Uuid
  waMessageId   String?   @map("wa_message_id") @db.VarChar(100)
  status        String    @default("PENDING") @db.VarChar(20)
  errorMessage  String?   @map("error_message")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz()
  readAt        DateTime? @map("read_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, leadId])
  @@index([businessId])
  @@index([businessId, broadcastId])
  @@index([businessId, leadId])
  @@index([businessId, status])
  @@map("broadcast_logs")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(500)
  userAgent    String?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, userId])
  @@index([refreshToken])
  @@map("sessions")
}
